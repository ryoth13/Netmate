    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (OpenOCD + J-Link)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/Netmate.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "serverpath": "openocd",
            "searchDir": [
                "${workspaceFolder}/.vscode"
            ],
            "configFiles": [
                "${workspaceFolder}/.vscode/openocd-jlink.cfg"
            ]
        },
        {
            "name": "Cortex Debug (OpenOCD + J-Link, Erase)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/Netmate.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "serverpath": "openocd",
            "searchDir": [
                "${workspaceFolder}/.vscode"
            ],
            "configFiles": [
                "${workspaceFolder}/.vscode/openocd-jlink.cfg"
            ],
            "preLaunchCommands": [
                "monitor reset halt",
                "monitor stm32f4x mass_erase 0"
            ]
        }
